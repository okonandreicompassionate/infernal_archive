# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Optional alternative. Set AI_PROVIDER=groq to use Groq instead of Gemini.
AI_PROVIDER="gemini"
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_MODEL="llama-3.3-70b-versatile"

# Resend is used for admin invitations when configured.
# Replace the placeholder with your real key in Render, never in source control.
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM="onboarding@resend.dev"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Hosted frontend URL, used for Supabase invite/password redirects.
APP_URL="https://your-frontend.vercel.app"
PORT="3000"
NODE_ENV="production"
CORS_ORIGIN="https://your-frontend-domain.example"
VITE_API_URL="https://your-api-domain.example"
SERVE_FRONTEND="false"

# Supabase project used by the Universe OS API.
NEXT_PUBLIC_SUPABASE_URL="https://rhjjxcwdcvhpusnecvxo.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
VITE_SUPABASE_URL="https://rhjjxcwdcvhpusnecvxo.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Server-only key. Never expose this as NEXT_PUBLIC or VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
